# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Cole a connection string do seu MongoDB Atlas (ou local)
# Formato Atlas: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://seu_usuario:sua_senha@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority

# ─── NextAuth ────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=           # gere com: openssl rand -base64 32

# ─── Credenciais do administrador ────────────────────────────────────────────
EMAIL_USER=7empresaelcio@gmail.com
PASSWORD_USER=sua-senha-aqui

# ─── Cloudinary (upload de imagens dos projetos) ─────────────────────────────
CLOUDINARY_CLOUD_NAME=seu-cloud-name
CLOUDINARY_API_KEY=sua-api-key
CLOUDINARY_API_SECRET=seu-api-secret

# ─── WhatsApp ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=5599996452760
